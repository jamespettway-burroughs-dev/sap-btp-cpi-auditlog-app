# SAP BTP Authentication
BTP_USERNAME=your_btp_username@company.com
BTP_PASSWORD=your_btp_password
BTP_SUBDOMAIN=your_subaccount_id
BTP_REGION=us20

# SAP BTP OAuth Configuration
BTP_CLIENT_ID=sb-clone-auditlog-xsuaa-app!b123|auditlog-xsuaa!b123
BTP_CLIENT_SECRET=your_client_secret_here
BTP_TOKEN_URL=https://authentication.us20.hana.ondemand.com/oauth/token

# SAP BTP Host Configuration
BTP_HOST=authentication.us20.hana.ondemand.com
AUDITLOG_API_HOST=auditlog-management.cfapps.us20.hana.ondemand.com
AUDITLOG_API_PATH=/auditlog/v2/auditlogrecords

# Application Configuration
PORT=3000
NODE_ENV=development

# Optional: Logging
LOG_LEVEL=info
